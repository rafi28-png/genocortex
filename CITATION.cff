    family-names: "Rahman"
    email: rafiur2810@gmail.com
    affiliation: "Department of Biochemistry and Biotechnology, North South University, Dhaka, Bangladesh"
version: "1.0.0"
license: MIT
repository-code: "https://github.com/rafi28-png/genocortex"
keywords:
  - bioinformatics
  - alignment-free sequence comparison
  - chaos game representation
  - predictive coding
  - minimum description length
  - self-organising maps
  - phylogenetics
  - anomaly detection
